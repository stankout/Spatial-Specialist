# AI runtime
OPENAI_API_KEY=

# Database
DATABASE_URL=

# Notion command center
NOTION_API_KEY=
NOTION_TASKS_DATABASE_ID=

# Public app URL
NEXT_PUBLIC_APP_URL=

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_SUPPORTED_LOCALES=vi,en

# Website adapters (optional; mock mode works without these values)
LEAD_PROVIDER=mock
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BOOKING_URL=

# AC Business Platform feature flags (safe defaults are disabled except search/blog/booking)
NEXT_PUBLIC_COMMERCE_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_DIGITAL_PRODUCTS_ENABLED=false
NEXT_PUBLIC_PHYSICAL_PRODUCTS_ENABLED=false
NEXT_PUBLIC_AFFILIATE_PRODUCTS_ENABLED=false
NEXT_PUBLIC_PRINT_ON_DEMAND_ENABLED=false
NEXT_PUBLIC_PAID_QUESTIONS_ENABLED=false
NEXT_PUBLIC_CONSULTATION_BOOKING_ENABLED=true
NEXT_PUBLIC_CUSTOMER_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_SITE_SEARCH_ENABLED=true
NEXT_PUBLIC_PORTFOLIO_ENABLED=false
NEXT_PUBLIC_BLOG_ENABLED=true

# Provider selectors. Values only; never place secrets in this template.
PAYMENT_PROVIDER=disabled
POD_PROVIDER=disabled
SCHEDULING_PROVIDER=manual
AUTH_PROVIDER=
SOCIAL_PUBLISHING_PROVIDER=
DIGITAL_DELIVERY_PROVIDER=
BACKUP_PROVIDER=
# Local audit JSONL is for development observability only.
AUDIT_PROVIDER=local
PAYMENT_WEBHOOK_SECRET=

# Owner/legal readiness confirmations
PRIVACY_REVIEWED=false
TERMS_REVIEWED=false
REFUND_POLICY_REVIEWED=false

# Owner Content Studio (local development only until real auth/storage are implemented)
STUDIO_ENABLED=false
MEDIA_STORAGE_PROVIDER=local
# Comma-separated HTTPS hostnames permitted for Custom Iframe embeds.
EMBED_ALLOWED_HOSTS=

# Signature offers remain hidden until the owner confirms scope and availability.
MARKET_READY_AUDIT_ACTIVE=false
BUYER_PROPERTY_RISK_REVIEW_ACTIVE=false
PROPERTY_PREPARATION_CONCIERGE_ACTIVE=false
